{
  "phase": 1,
  "seed": 42,
  "positive_class": ">50K",
  "negative_class": "<=50K",
  "decision_threshold": 0.5,
  "selection_metric": "roc_auc",
  "tie_breaker_metric": "f1",
  "split": {
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15
  },
  "preprocessing": {
    "numeric_imputation": "median",
    "categorical_imputation": "constant",
    "categorical_fill_value": "Missing",
    "encoder": "one-hot",
    "handle_unknown": "ignore",
    "logistic_regression_scaler": "standard",
    "tree_scaler": null
  },
  "models": {
    "logistic_regression": {
      "display_name": "Logistic Regression",
      "fixed": {
        "solver": "lbfgs",
        "max_iter": 2000,
        "random_state": 42
      },
      "grid": [
        {"C": 0.1, "class_weight": null},
        {"C": 1.0, "class_weight": null},
        {"C": 10.0, "class_weight": null},
        {"C": 0.1, "class_weight": "balanced"},
        {"C": 1.0, "class_weight": "balanced"},
        {"C": 10.0, "class_weight": "balanced"}
      ]
    },
    "random_forest": {
      "display_name": "Random Forest",
      "fixed": {
        "n_estimators": 200,
        "max_features": "sqrt",
        "bootstrap": true,
        "n_jobs": -1,
        "random_state": 42
      },
      "grid": [
        {"max_depth": 12, "min_samples_leaf": 1},
        {"max_depth": 12, "min_samples_leaf": 5},
        {"max_depth": 24, "min_samples_leaf": 1},
        {"max_depth": 24, "min_samples_leaf": 5}
      ]
    },
    "xgboost": {
      "display_name": "XGBoost",
      "fixed": {
        "n_estimators": 200,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "min_child_weight": 1,
        "reg_lambda": 1.0,
        "objective": "binary:logistic",
        "eval_metric": "logloss",
        "tree_method": "hist",
        "n_jobs": -1,
        "random_state": 42,
        "verbosity": 0
      },
      "grid": [
        {"max_depth": 3, "learning_rate": 0.05},
        {"max_depth": 3, "learning_rate": 0.1},
        {"max_depth": 6, "learning_rate": 0.05},
        {"max_depth": 6, "learning_rate": 0.1}
      ]
    }
  }
}
